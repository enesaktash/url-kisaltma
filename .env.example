# Vercel ortam degiskenleri.
#
# Bu dosya sadece hangi degiskenlerin gerektigini gosterir; degerler bostur
# ve gercek anahtarlar buraya ASLA yazilmaz.
#
# Vercel'de: Project > Settings > Environment Variables
# Yerelde:   bu dosyayi ".env" adiyla kopyala (git tarafindan yoksayilir)

# --- ZORUNLU: Upstash Redis (kalici depo) ---
# upstash.com > Redis > Create Database > REST API bolumu
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- ISTEGE BAGLI: Google Safe Browsing (zararli baglanti kontrolu) ---
# Bos birakilirsa kontrol atlanir, uygulama calismaya devam eder.
# console.cloud.google.com > APIs & Services > Library > Safe Browsing API
SAFE_BROWSING_API_KEY=
